    "#bai2.11\n",
    "import math\n",
    "\n",
    "def ham_f(x):\n",
    "    return x**3 - x - 2\n",
    "\n",
    "can_duoi, can_tren = 1.0, 2.0\n",
    "sai_so_cho_phep = 1e-10\n",
    "so_buoc = 0\n",
    "\n",
    "while (can_tren - can_duoi) >= sai_so_cho_phep:\n",
    "    diem_giua = (can_duoi + can_tren) / 2\n",
    "    so_buoc += 1\n",
    "    \n",
    "    if ham_f(can_duoi) * ham_f(diem_giua) < 0:\n",
    "        can_tren = diem_giua\n",
    "    else:\n",
    "        can_duoi = diem_giua\n",
    "\n",
    "nghiem_xap_xi = (can_duoi + can_tren) / 2\n",
    "so_buoc_ly_thuyet = math.ceil(math.log2((2.0 - 1.0) / sai_so_cho_phep))\n",
    "\n",
    "print(f\"Nghiem xap xi: {nghiem_xap_xi:.12f}\")\n",
    "print(f\"So buoc thuc te: {so_buoc}\")\n",
    "print(f\"So buoc ly thuyet: {so_buoc_ly_thuyet}\")\n",
    "\n",
    "assert so_buoc == so_buoc_ly_thuyet\n",
    "print(\"Kiem chung thanh cong: So buoc thuc te khop hoan toan voi ly thuyet!\")"
   ]
