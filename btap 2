    "import math\n",
    "\n",
    "tong_so = 0.0\n",
    "dem = 0\n",
    "lon_nhat = -math.inf\n",
    "nho_nhat = math.inf\n",
    "\n",
    "print(\"Nhap cac so thuc (go 'xong' de ket thuc):\")\n",
    "while True:\n",
    "    user_input = input(\"Nhap so: \")\n",
    "    if user_input.strip().lower() == \"xong\":\n",
    "        break\n",
    "    try:\n",
    "        val = float(user_input)\n",
    "        tong_so += val\n",
    "        dem += 1\n",
    "        if val > lon_nhat:\n",
    "            lon_nhat = val\n",
    "        if val < nho_nhat:\n",
    "            nho_nhat = val\n",
    "    except ValueError:\n",
    "        print(f\"  -> Bo qua gia tri khong phai so hop le: {user_input}\")\n",
    "\n",
    "if dem > 0:\n",
    "    trung_binh = tong_so / dem\n",
    "    print(\"\\n--- KET QUA THONG KE ---\")\n",
    "    print(f\"So gia tri hop le: {dem}\")\n",
    "    print(f\"Tong: {tong_so}\")\n",
    "    print(f\"Trung binh: {trung_binh}\")\n",
    "    print(f\"Gia tri lon nhat: {lon_nhat}\")\n",
    "    print(f\"Gia tri nho nhat: {nho_nhat}\")\n",
    "else:\n",
    "    print(\"Chua co du lieu\")"
   ]
