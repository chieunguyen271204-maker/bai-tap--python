    "#baif2.7\n",
    "def tinh_day_collatz(n: int):\n",
    "    so_buoc = 0\n",
    "    gia_tri_max = n\n",
    "    \n",
    "    while n > 1:\n",
    "        if n % 2 == 0:\n",
    "            n = n // 2\n",
    "        else:\n",
    "            n = 3 * n + 1\n",
    "        \n",
    "        so_buoc += 1\n",
    "        if n > gia_tri_max:\n",
    "            gia_tri_max = n\n",
    "            \n",
    "    return so_buoc, gia_tri_max\n",
    "\n",
    "n_ban_dau = 27\n",
    "so_buoc, gia_tri_lon_nhat = tinh_day_collatz(n_ban_dau)\n",
