    "#baif2.10\n",
    "import random\n",
    "import math\n",
    "\n",
    "random.seed(2026)\n",
    "\n",
    "danh_sach_N = [10**2, 10**4, 10**6]\n",
    "\n",
    "for n in danh_sach_N:\n",
    "    trong_hinh_tron = 0\n",
    "    for _ in range(n):\n",
    "        x, y = random.uniform(-1, 1), random.uniform(-1, 1)\n",
    "        if x**2 + y**2 <= 1:\n",
    "            trong_hinh_tron += 1\n",
    "            \n",
    "    pi_uoc_luong = 4 * trong_hinh_tron / n\n",
    "    sai_so_tuyet_doi = abs(pi_uoc_luong - math.pi)\n",
    "    nguong_gioi_han = 6 / math.sqrt(n)\n",
    "    \n",
    "    print(f\"N = {n:7,d} | Pi uoc luong: {pi_uoc_luong:.5f} | Sai so: {sai_so_tuyet_doi:.5f} | Nguong: {nguong_gioi_han:.5f}\")\n",
    "    \n",
    "    assert sai_so_tuyet_doi < nguong_gioi_han\n",
    "\n",
    "print(\"Tat ca cac moc N deu thoa man dieu kien assert!\")\n"
   ]
